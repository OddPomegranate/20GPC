<?xml version="1.0" encoding="utf-8"?>
<!--
This file contains an xml description of a font, and will be read by the
MonoGame Content Pipeline. Follow the comments to customize the appearance
of the font in your game, and to change the characters which are available
to draw with.

REBUILT (fonts-corrupted fix): every original *.xnb font in this project is
a precompiled Xbox 360 SpriteFont binary, never rebuilt for PC (Content.mgcb
had no /build: entries for any font - only for the .fx effects). These load
on MonoGame/DesktopGL but render with garbled/noisy glyph textures, the same
class of Xbox360-vs-PC XNB incompatibility documented elsewhere in this
project for effects and (separately) for texture color-channel ordering.
This MainMenuFont.spritefont is a real Content Pipeline SOURCE file, so it
compiles fresh on PC via FontDescriptionImporter/FontDescriptionProcessor
(see Content.mgcb) instead of relying on a precompiled binary - no noise.
The old broken Content/Menu/Fonts/MainMenuFont.xnb was moved to
Content/_xbox360_original_effects_backup/Menu/Fonts/ so it no longer
conflicts with this freshly-built one at the same output path. Every
Load<SpriteFont>(...) call across the whole project (originally pointing at
~30 different per-minigame corrupted fonts) now loads this one font instead,
per the user's request - so every text draw in every game uses whatever
size/scale multiplier that draw call already applies on top of this font's
base size below; some HUD/debug text that used a tiny original font may now
look larger than before, and some "jumbo"/win-screen text that used a huge
original font may now look smaller, since a single shared font can't match
every original per-game font's size. Adjust <Size> below (or add
scale-parameter tweaks at individual DrawString call sites) if particular
text reads too big/small after rebuilding.
-->
<XnaContent xmlns:Graphics="Microsoft.Xna.Framework.Content.Pipeline.Graphics">
  <Asset Type="Graphics:FontDescription">

    <!--
    Modify this string to change the font that will be imported.
    -->
    <FontName>Segoe UI</FontName>

    <!--
    Size is a float value, measured in points. Modify this value to change
    the size of the font.
    -->
    <Size>24.96</Size>

    <!--
    Spacing is a float value, measured in pixels. Modify this value to
    change the amount of spacing in between characters.
    -->
    <Spacing>0</Spacing>

    <!--
    UseKerning controls the layout of the font. If this value is true,
    kerning information will be used when placing characters.
    -->
    <UseKerning>true</UseKerning>

    <!--
    Style controls the style of the font. Valid entries are "Regular",
    "Bold", "Italic", and "Bold, Italic", and are case sensitive.
    -->
    <Style>Regular</Style>

    <!--
    If you uncomment this line, the default character will be substituted
    if you draw or measure text that contains characters which were not
    included in the font.
    -->
    <DefaultCharacter>*</DefaultCharacter>

    <!--
    CharacterRegions control what letters are available in the font. Every
    character from Start to End will be built and made available for
    drawing. The default range is from 32 to 126.
    -->
    <CharacterRegions>
      <CharacterRegion>
        <Start>&#32;</Start>
        <End>&#126;</End>
      </CharacterRegion>
    </CharacterRegions>
  </Asset>
</XnaContent>
