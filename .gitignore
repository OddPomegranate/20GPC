# Build output (regenerated by `dotnet build`/`dotnet publish`)
bin/
obj/

# Visual Studio local state (VS Code's .vscode/launch.json is kept - it's shared config, not cache)
.vs/

# Per-developer / per-machine files
*.user
*.suo

# Leftover local diagnostics, not meant to ship
_diagnostic_artifacts_to_delete/

# OS junk
.DS_Store
Thumbs.db
